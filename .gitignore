# Rahasia — JANGAN pernah di-commit (semua kredensial lewat GitHub Secrets)
.env

# MCP pihak ketiga yang di-clone saat runtime oleh workflow
vendor/

# Python
__pycache__/
*.pyc

# Berkas cache Windows yang sempat terbawa `git add -A` dari luar pohon repo
# (commit b9e9a49). Bukan bagian proyek — 0,98 MB yang ikut ditarik tiap clone.
%SystemDrive%/
*.ver0x*.db
cversions.*.db

# Cache derivatif: 97 KB agregat yang berubah tiap 30 menit dan hanya mempercepat
# run yang sedang berjalan. Arsipnya (derivatif_arsip.jsonl) TETAP di-commit —
# itu riwayat OI yang ditumbuhkan sendiri dan tidak bisa diambil ulang.
cloud/data/derivatif_cache.json

# Daftar pasar Coinalyze: cache seminggu, bisa ditarik ulang kapan saja.
cloud/data/coinalyze_pasar.json

# Penanda batas baca Telegram yang BELUM berlaku — dipromosikan workflow, bukan di-commit.
cloud/data/tg_batas_calon.json
